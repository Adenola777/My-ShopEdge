# MyShopEdge admin (A34). Copy to .env.local and fill in.
#
# Every variable here is NEXT_PUBLIC_, so it is compiled into the JavaScript the browser
# downloads and is public. Never add a secret. The admin site reaches the database only
# through the service, which admits only the addresses in ADMIN_EMAILS on the service.

# Where the Python service is.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1

# The same Stack Auth project the seller app uses. The admin site's address must be on Neon
# Auth's trusted domains, or the Google sign-in cannot return to it.
NEXT_PUBLIC_STACK_PROJECT_ID=f1762e29-4750-42f6-80e1-c94b040a72e8
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=the-publishable-client-key-from-the-Neon-Auth-page
